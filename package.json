{
  "name": "nuvortiq-smart-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap-admin": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "db:local": "tsx scripts/local-postgres.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "9.39.3",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
