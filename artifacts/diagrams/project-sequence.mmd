%% Implemented native booking flows and current integration boundaries.
%% Email code delivery and cancellation notices are planned; clinic booking email is localhost simulation only.
sequenceDiagram
    autonumber
    actor Patient
    actor Doctor as Doctor / Admin
    actor Staff
    participant App as Booking App
    participant Auth as Auth and Access
    participant Schedule as Shared Scheduling Service
    participant DB as PostgreSQL
    participant Email as Email Preview / Provider
    participant Worker as WhatsApp Worker or Request Handler
    participant Meta as Meta WhatsApp API

    rect rgb(238, 246, 255)
        Note over Patient,Email: Patient login and booking
        Patient->>App: Enter email and request one-time code
        App->>Auth: Request patient code
        Auth->>DB: Save expiring code request
        alt Localhost test mode
            App-->>Patient: Prompt for requested test code (0000)
        else Email delivery is connected in a future release
            Auth-->>Email: Planned login-code delivery
            Email-->>Patient: Planned one-time code delivery
        end
        Patient->>App: Submit code
        App->>Auth: Verify code and create patient if new
        Auth->>DB: Check code; create patient/session
        DB-->>App: Patient session
        App-->>Patient: Show available dates and slots
        Patient->>App: Select slot, enter details and optional WhatsApp consent
        App->>Schedule: Confirm booking request
        Schedule->>DB: Lock doctor; recheck slot and policy
        alt Slot unavailable or policy rejects
            DB-->>Schedule: Reject
            Schedule-->>App: Validation/conflict result
            App-->>Patient: Choose another slot or follow policy guidance
        else Booking accepted
            Schedule->>DB: Commit appointment, occupancy, audit, receipt and consent/job
            DB-->>Schedule: Commit succeeded
            Schedule-->>App: Confirmed appointment
            App-->>Patient: Show confirmation
            opt Active WhatsApp consent
                App->>Worker: Attempt post-commit notification or leave queued job
                Worker->>DB: Claim job and save safe attempt record
                Worker->>Meta: Send using test sender and fixed owner test recipient
                Meta-->>Worker: Accepted, rejected or outcome uncertain
                Worker->>DB: Record result; retry safe failures as configured
                Note over Patient,Meta: API acceptance is not proof of delivery; failures do not undo booking.
            end
        end
        Patient->>App: Open My appointments
        App->>Auth: Check patient session and ownership
        Auth->>DB: Read only explicitly linked appointments
        DB-->>App: Patient's appointments
        App-->>Patient: Show appointment history and status
    end

    rect rgb(241, 250, 242)
        Note over Doctor,Email: Doctor manages clinic, staff and daily agenda
        Doctor->>App: Sign in with email and PIN
        App->>Auth: Verify admin PIN and access
        Auth->>DB: Check account, lockout and session
        DB-->>App: Admin session
        Doctor->>App: Configure hours, breaks and special dates
        App->>Schedule: Save availability change
        Schedule->>DB: Validate conflicts and persist schedule
        Doctor->>App: Add, list, disable or re-enable staff
        App->>Auth: Apply admin-only staff management
        Auth->>DB: Save staff access; revoke sessions on disable
        Doctor->>App: Open daily agenda
        App->>DB: Read appointments for selected clinic date
        DB-->>App: Confirmed, cancelled and other history
        App-->>Doctor: Show agenda and appointment details
    end

    rect rgb(255, 249, 237)
        Note over Staff,Email: Staff sign-in, clinic booking and agenda
        Staff->>App: Enter email and request code
        App->>Auth: Verify active staff account and issue code
        Auth->>DB: Save expiring code request
        alt Localhost test mode
            App-->>Staff: Prompt for requested test code (0000)
        else Email delivery is connected in a future release
            Auth-->>Email: Planned staff login-code delivery
            Email-->>Staff: Planned one-time code delivery
        end
        Staff->>App: Submit code
        App->>Auth: Verify staff code (staff must already exist)
        Auth->>DB: Check active staff access and create session
        Staff->>App: Open agenda or book appointment
        App->>DB: Read agenda or request available slots
        Staff->>App: Enter patient details and confirm
        App->>Schedule: Confirm clinic-created booking
        Schedule->>DB: Lock doctor; recheck and commit appointment, occupancy, audit and receipt
        Note over Schedule,DB: Local email template job is included in this transaction when localhost preview fallback applies.
        DB-->>Schedule: Commit succeeded
        Schedule-->>App: Confirmed clinic-created appointment
        opt SMTP_HOST absent or blank on localhost development/test
            App->>Email: After commit, write redacted simulated confirmation log
            Email-->>App: Preview result; booking remains confirmed if logging fails
        end
        Note over Staff,Email: Clinic-created visits do not auto-link patient accounts or request WhatsApp delivery.
    end

    rect rgb(255, 240, 240)
        Note over Patient,Email: Cancellation and rebooking
        alt Patient cancels own future confirmed visit
            Patient->>App: Cancel from My appointments
            App->>Auth: Check patient session and appointment ownership
            Auth->>Schedule: Authorize patient self-cancellation
        else Doctor/admin cancels a visit
            Doctor->>App: Cancel from agenda with reason and optional block/rebooking instruction
            App->>Auth: Check admin session
            Auth->>Schedule: Authorize cancellation and admin options
        else Staff cancels clinic-created visit
            Staff->>App: Cancel future confirmed clinic-created visit with reason
            App->>Auth: Check staff session and appointment origin
            Auth->>Schedule: Authorize allowed staff cancellation
        end
        Schedule->>DB: Lock doctor; cancel, release or block time, audit atomically
        DB-->>Schedule: Cancellation committed
        Schedule-->>App: Cancelled appointment and saved reason
        App-->>Patient: Show cancelled status when patient initiated
        App-->>Doctor: Update agenda and cancelled history
        App-->>Staff: Update agenda and cancelled history
        opt Patient chooses to book again
            Patient->>App: Start a separate booking
            App->>Schedule: Recheck current availability and policy
            Note over Patient,Schedule: A suggested time does not reserve a slot; patient cancellation and rebooking are separate.
        end
        Note over Doctor,Email: Automatic cancellation email is planned; no cancellation notice is sent in the current implementation.
    end
