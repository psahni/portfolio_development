end ref

ref over Patient, App : [[patient-booking-whatsapp.puml Patient booking and WhatsApp]]
end ref

== Cancellation and rebooking ==
ref over Patient, App : [[patient-cancellation.puml Patient cancellation and rebooking]]
end ref

ref over Doctor, Schedule : [[clinic-cancellation.puml Clinic cancellation]]
end ref
@enduml
