# Copy to .env.local. Values here are for localhost development only.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://nuvortiq:nuvortiq_dev_only@127.0.0.1:54329/nuvortiq
MIGRATION_DATABASE_URL=postgresql://nuvortiq:nuvortiq_dev_only@127.0.0.1:54329/nuvortiq
# Generate two DIFFERENT secrets: openssl rand -base64 48
PATIENT_AUTH_SECRET=
STAFF_AUTH_SECRET=
# Appointment contact encryption: openssl rand -base64 32
# Keep stable and back up securely; losing it makes saved contacts unreadable.
BOOKING_DATA_KEY=
# Optional localhost-only test login. Never enable in production.
AUTH_TEST_MODE=false
# Set before explicit bootstrap; no PIN is hardcoded or printed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Doctor
BOOTSTRAP_ADMIN_PIN=
# Staff login currently uses localhost test mode; real email delivery is a later task.

# Phase 1: Meta test sender and ONE pre-verified recipient only. No patient phone routing.
# Disabled by default. Set only for synthetic, consented test bookings; production is rejected.
WHATSAPP_ENABLED=false
# true: separate worker (default); false: send after commit in the booking request.
WHATSAPP_USE_WORKER=true
WHATSAPP_ACCESS_TOKEN=
# Use the API version shown in your Meta app's Try it Out request.
WHATSAPP_API_VERSION=
WHATSAPP_TEST_PHONE_NUMBER_ID=
# International format, including +country code. Your registered test recipient only.
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# no_parameters: hello_world connectivity test, not appointment details.
# appointment: approved body template with positional parameters: local visit time, timezone.
WHATSAPP_TEMPLATE_MODE=no_parameters

# SMTP transport is deferred. Leave blank for a local redacted booking-email preview.
# A nonempty host disables simulation; it does not enable real email delivery yet.
# Preview only runs in localhost development/test. Apply migration 0009 first.
SMTP_HOST=
